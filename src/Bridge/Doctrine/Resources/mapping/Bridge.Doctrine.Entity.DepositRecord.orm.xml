<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Deposits (ADR 0005, 0008). Read and written with DBAL only: the claim and the optimistic lock are conditional
         statements. open_reference / open_fingerprint repeat the reference and the fingerprint while the deposit is open
         and are NULL once it is closed: a portable partial uniqueness. -->
    <entity name="TheBeardedBear\UrssafDpae\Bridge\Doctrine\Entity\DepositRecord" table="urssaf_dpae_deposits" read-only="true">
        <unique-constraints>
            <unique-constraint name="uniq_urssaf_dpae_deposit_flow_id" columns="tenant_id,flow_id"/>
            <unique-constraint name="uniq_urssaf_dpae_deposit_open_reference" columns="tenant_id,open_reference"/>
            <unique-constraint name="uniq_urssaf_dpae_deposit_open_fingerprint" columns="tenant_id,open_fingerprint"/>
        </unique-constraints>
        <indexes>
            <index name="idx_urssaf_dpae_deposit_claim" columns="tenant_id,state,claimed_at"/>
            <index name="idx_urssaf_dpae_deposit_state" columns="tenant_id,state,updated_at"/>
            <index name="idx_urssaf_dpae_deposit_reference" columns="tenant_id,external_reference"/>
        </indexes>
        <id name="id" type="urssaf_dpae_deposit_id" column="id" length="64">
            <generator strategy="NONE"/>
        </id>
        <field name="tenantId" type="urssaf_dpae_tenant_id" column="tenant_id" length="64"/>
        <field name="externalReference" type="urssaf_dpae_external_reference" column="external_reference" length="100"/>
        <field name="fingerprint" type="urssaf_dpae_fingerprint" column="fingerprint" length="64"/>
        <field name="mode" type="string" column="mode" length="16" enum-type="TheBeardedBear\UrssafDpae\Domain\Declaration\DeclarationMode"/>
        <field name="declarantSiret" type="urssaf_dpae_siret" column="declarant_siret" length="14" nullable="true"/>
        <field name="state" type="string" column="state" length="32" enum-type="TheBeardedBear\UrssafDpae\Domain\Deposit\DepositState"/>
        <field name="attempts" type="integer" column="attempts"/>
        <field name="claimedAt" type="urssaf_dpae_instant" column="claimed_at"/>
        <field name="updatedAt" type="urssaf_dpae_instant" column="updated_at"/>
        <field name="flowId" type="urssaf_dpae_flow_id" column="flow_id" length="50" nullable="true"/>
        <field name="result" type="urssaf_dpae_deposit_result" column="result" nullable="true"/>
        <field name="lastErrorCode" type="string" column="last_error_code" length="100" nullable="true"/>
        <field name="adopted" type="boolean" column="adopted"/>
        <field name="version" type="integer" column="version"/>
        <field name="openReference" type="urssaf_dpae_external_reference" column="open_reference" length="100" nullable="true"/>
        <field name="openFingerprint" type="urssaf_dpae_fingerprint" column="open_fingerprint" length="64" nullable="true"/>
    </entity>
</doctrine-mapping>
