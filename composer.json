{
    "name": "thebeardedbear/urssaf-dpae",
    "description": "Client and domain model for the URSSAF \"API DPAE\" (Déclaration Préalable À l'Embauche: deposit and returns)",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "urssaf",
        "api",
        "dpae",
        "declaration-prealable-embauche",
        "embauche",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "The Bearded Bear",
            "homepage": "https://the-bearded-bear.com"
        }
    ],
    "homepage": "https://the-bearded-bear.com/open-source/urssaf-dpae",
    "support": {
        "issues": "https://github.com/TheBeardedBearSAS/urssaf-dpae/issues",
        "source": "https://github.com/TheBeardedBearSAS/urssaf-dpae",
        "security": "https://github.com/TheBeardedBearSAS/urssaf-dpae/security/policy"
    },
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59",
        "deptrac/deptrac": "^4.7",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^2.19 || ^3.0",
        "doctrine/orm": "^3.5.3",
        "doctrine/persistence": "^3.4.1 || ^4.0",
        "ergebnis/composer-normalize": "^2.56",
        "ergebnis/phpstan-rules": "^2.17",
        "friendsofphp/php-cs-fixer": "^3.95",
        "icanhazstring/composer-unused": "^0.9",
        "infection/infection": "^0.32",
        "maglnet/composer-require-checker": "^4.17",
        "nyholm/psr7": "^1.8.2",
        "php-http/client-common": "^2.7.2",
        "php-http/discovery": "^1.19.3",
        "php-http/httplug": "^2.4.1",
        "php-http/message": "^1.16.1",
        "php-http/mock-client": "^1.6.1",
        "php-http/promise": "^1.2.2",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpdoc-parser": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.8",
        "roave/security-advisories": "dev-latest",
        "shipmonk/phpstan-rules": "^4.4",
        "symfony/cache": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/cache-contracts": "^2.5.3 || ^3.4.2",
        "symfony/clock": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/console": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4.26 || ^7.4 || ^8.0",
        "symfony/error-handler": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/event-dispatcher-contracts": "^2.5.3 || ^3.4.2",
        "symfony/filesystem": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/framework-bundle": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/lock": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/messenger": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/polyfill-php83": "^1.31",
        "symfony/process": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/property-access": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/property-info": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/scheduler": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/serializer": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/string": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/translation": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/translation-contracts": "^2.5.3 || ^3.4.2",
        "symfony/uid": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/validator": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/var-dumper": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/var-exporter": "^6.4.3 || ^7.4 || ^8.0",
        "symfony/yaml": "^6.4.3 || ^7.4 || ^8.0",
        "tomasvotruba/type-coverage": "^2.5"
    },
    "conflict": {
        "doctrine/dbal": "<4.0",
        "doctrine/doctrine-bundle": "<2.19",
        "doctrine/orm": "<3.5.3",
        "nyholm/psr7": "<1.8.2",
        "symfony/clock": "<6.4.3",
        "symfony/console": "<6.4",
        "symfony/dependency-injection": "<6.4.26",
        "symfony/framework-bundle": "<6.4.3",
        "symfony/http-client": "<6.4",
        "symfony/http-kernel": "<6.4",
        "symfony/lock": "<6.4.3",
        "symfony/messenger": "<6.4.3",
        "symfony/scheduler": "<6.4.3"
    },
    "suggest": {
        "doctrine/dbal": "Required by the Doctrine bridge (custom types, DBAL repositories)",
        "doctrine/doctrine-bundle": "Required to use the Doctrine bridge in a Symfony application",
        "doctrine/orm": "Required by the Doctrine bridge (mapping of the tables, schema and migrations)",
        "nyholm/psr7": "PSR-17 factories for the HTTP gateway (any PSR-17 implementation works)",
        "symfony/console": "Required by the Symfony bridge (the urssaf:dpae:* commands)",
        "symfony/framework-bundle": "Required to use the Symfony bridge (UrssafDpaeBundle, alias urssaf_dpae)",
        "symfony/http-client": "PSR-18 compatible HTTP client for the API (any PSR-18 client works)",
        "symfony/lock": "Prevents overlapping runs of the same operation per tenant (Symfony bridge, non-blocking locks urssaf_dpae.<operation>.<scope>)",
        "symfony/messenger": "Messenger messages and handlers of the Symfony bridge, and the outbox relay sink",
        "symfony/scheduler": "Runs the crons of the package as the Symfony schedule urssaf_dpae",
        "symfony/translation": "Translates the violation codes of the package (translation domain urssaf_dpae, en and fr)"
    },
    "autoload": {
        "psr-4": {
            "TheBeardedBear\\UrssafDpae\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheBeardedBear\\UrssafDpae\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
